{
  "$ref": "#/definitions/ArcDiagramData",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AnchorPosition": {
      "enum": [
        "left",
        "right",
        "top",
        "bottom",
        "bottomLeft",
        "bottomRight",
        "topLeft",
        "topRight"
      ],
      "type": "string"
    },
    "ArcDiagramData": {
      "additionalProperties": false,
      "properties": {
        "_meta": {
          "$ref": "#/definitions/FileMeta",
          "description": "Viewer/editor display state saved with the file — see `FileMeta`."
        },
        "connectorStyles": {
          "additionalProperties": {
            "$ref": "#/definitions/ConnectorStyle"
          },
          "type": "object"
        },
        "connectors": {
          "items": {
            "$ref": "#/definitions/Connector"
          },
          "type": "array"
        },
        "flows": {
          "description": "Animated message/packet routes across connectors.",
          "items": {
            "$ref": "#/definitions/DiagramFlow"
          },
          "type": "array"
        },
        "focusTargets": {
          "additionalProperties": {
            "$ref": "#/definitions/FocusTarget"
          },
          "type": "object"
        },
        "groups": {
          "items": {
            "$ref": "#/definitions/GroupShape"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "layout": {
          "$ref": "#/definitions/DiagramLayout"
        },
        "layoutHints": {
          "$ref": "#/definitions/LayoutHints"
        },
        "legend": {
          "$ref": "#/definitions/LegendMode",
          "description": "Authored legend policy: 'auto' | 'all' | 'hidden'."
        },
        "nodeData": {
          "additionalProperties": {
            "$ref": "#/definitions/NodeData"
          },
          "type": "object"
        },
        "nodes": {
          "additionalProperties": {
            "$ref": "#/definitions/NodePosition"
          },
          "type": "object"
        },
        "views": {
          "items": {
            "$ref": "#/definitions/DiagramView"
          },
          "type": "array"
        }
      },
      "required": [
        "layout",
        "nodes",
        "nodeData",
        "connectors",
        "connectorStyles"
      ],
      "type": "object"
    },
    "ArrowHead": {
      "enum": [
        "none",
        "arrow",
        "open",
        "dot",
        "diamond",
        "bar",
        "dart"
      ],
      "type": "string"
    },
    "Connector": {
      "additionalProperties": false,
      "properties": {
        "curve": {
          "$ref": "#/definitions/ConnectorCurve"
        },
        "curveDepth": {
          "description": "Bezier control-point scale for curved connectors (percent of distance).",
          "type": "number"
        },
        "from": {
          "type": "string"
        },
        "fromAnchor": {
          "$ref": "#/definitions/AnchorPosition"
        },
        "fromRole": {
          "description": "Role annotation drawn near the `from` end, e.g. \"owner 1\".",
          "type": "string"
        },
        "id": {
          "description": "Stable identity for diffs, deep links, and diagnostics. Without it a connector is only addressable by `from`/`to` pair or array index, which breaks under reordering and parallel edges.",
          "type": "string"
        },
        "kind": {
          "description": "Relationship kind ('custom' by default). Inspector metadata.",
          "type": "string"
        },
        "label": {
          "description": "Label drawn beside this connector; overrides the style's `label`.",
          "type": "string"
        },
        "style": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "toAnchor": {
          "$ref": "#/definitions/AnchorPosition"
        },
        "toRole": {
          "description": "Role annotation drawn near the `to` end, e.g. \"items 0..*\".",
          "type": "string"
        }
      },
      "required": [
        "from",
        "to",
        "fromAnchor",
        "toAnchor",
        "style"
      ],
      "type": "object"
    },
    "ConnectorCurve": {
      "enum": [
        "natural",
        "down",
        "up",
        "step",
        "direct"
      ],
      "type": "string"
    },
    "ConnectorLineStyle": {
      "enum": [
        "solid",
        "dashed",
        "dotted"
      ],
      "type": "string"
    },
    "ConnectorStyle": {
      "additionalProperties": false,
      "properties": {
        "animated": {
          "type": "boolean"
        },
        "arrowScale": {
          "description": "When true, arrowhead size scales with `strokeWidth` (\"sizes follow .width\").",
          "type": "boolean"
        },
        "arrowSize": {
          "description": "Arrowhead length in px. Omit = auto.",
          "type": "number"
        },
        "bidirectional": {
          "type": "boolean"
        },
        "color": {
          "$ref": "#/definitions/DiagramColor",
          "description": "Omit for 'auto' — renderers fall back to the theme's neutral stroke."
        },
        "dashed": {
          "type": "boolean"
        },
        "fromArrow": {
          "$ref": "#/definitions/ArrowHead",
          "description": "Arrowhead at the `from` end. Omit = `bidirectional ? 'arrow' : 'none'`."
        },
        "fromArrowSize": {
          "description": "Per-end size overrides; omit = `arrowSize` then auto.",
          "type": "number"
        },
        "label": {
          "type": "string"
        },
        "labelAlign": {
          "$ref": "#/definitions/LabelAlign",
          "description": "For vertical connectors, `right`/`left` places the label beside the line."
        },
        "lineStyle": {
          "$ref": "#/definitions/ConnectorLineStyle",
          "description": "Stroke pattern; when set it takes precedence over `dashed`."
        },
        "opacity": {
          "description": "Stroke opacity 0–1.",
          "type": "number"
        },
        "showArrow": {
          "type": "boolean"
        },
        "showEndpoints": {
          "type": "boolean"
        },
        "strokeWidth": {
          "description": "Omit for 'auto' — renderers use a 2px stroke.",
          "type": "number"
        },
        "toArrow": {
          "$ref": "#/definitions/ArrowHead",
          "description": "Arrowhead at the `to` end. Omit = `showArrow === false ? 'none' : 'arrow'`."
        },
        "toArrowSize": {
          "type": "number"
        }
      },
      "type": "object"
    },
    "DiagramColor": {
      "enum": [
        "violet",
        "emerald",
        "blue",
        "amber",
        "sky",
        "zinc",
        "rose",
        "orange"
      ],
      "type": "string"
    },
    "DiagramFlow": {
      "additionalProperties": false,
      "description": "A message or packet travelling an ordered connector route. Renderers draw the marker beneath nodes, so node-to-node handoffs read as a single trip.",
      "properties": {
        "color": {
          "$ref": "#/definitions/DiagramColor",
          "description": "Palette color; defaults to the first connector's style color."
        },
        "delay": {
          "description": "Seconds before the first run (default: 0).",
          "type": "number"
        },
        "direction": {
          "$ref": "#/definitions/FlowDirection",
          "description": "Default leg direction (default: 'forward')."
        },
        "duration": {
          "description": "Total route seconds including inter-node pauses; overrides `speed`.",
          "type": "number"
        },
        "easing": {
          "$ref": "#/definitions/FlowEasing",
          "description": "Marker easing across each leg (default: 'linear')."
        },
        "hold": {
          "description": "Seconds hidden at the end of each run before repeating (default: 0).",
          "type": "number"
        },
        "id": {
          "description": "Stable flow id for diagnostics and tooling.",
          "type": "string"
        },
        "label": {
          "description": "Optional caption shown near the route.",
          "type": "string"
        },
        "legs": {
          "description": "Ordered connector legs; each leg may travel a connector in reverse.",
          "items": {
            "$ref": "#/definitions/DiagramFlowLeg"
          },
          "type": "array"
        },
        "marker": {
          "$ref": "#/definitions/FlowMarker",
          "description": "Marker treatment (default: 'dot')."
        },
        "repeat": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "const": "indefinite",
              "type": "string"
            }
          ],
          "description": "Repeat count, or 'indefinite' for a looping SVG/player (default)."
        },
        "size": {
          "description": "Marker diameter in px (default: 10).",
          "type": "number"
        },
        "speed": {
          "description": "Route pixels per second (default: 160). Ignored when `duration` is set.",
          "type": "number"
        },
        "trail": {
          "$ref": "#/definitions/FlowTrail",
          "description": "Motion trail treatment (default: 'none')."
        }
      },
      "required": [
        "id",
        "legs"
      ],
      "type": "object"
    },
    "DiagramFlowLeg": {
      "additionalProperties": false,
      "description": "One connector leg in a flow route. `id` pins a connector; `from`/`to` match an endpoint pair when no stable id exists. `direction` overrides the flow's own direction for this leg; `pause` is seconds spent under the destination node before continuing to the next leg.",
      "properties": {
        "direction": {
          "$ref": "#/definitions/FlowDirection"
        },
        "from": {
          "description": "Endpoint-pair matching, used when `id` is absent. Ambiguous on parallel edges.",
          "type": "string"
        },
        "id": {
          "description": "Pins a specific connector by `Connector.id` — survives reordering and parallel edges.",
          "type": "string"
        },
        "pause": {
          "type": "number"
        },
        "to": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "DiagramLayout": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "type": "number"
        },
        "width": {
          "type": "number"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "type": "object"
    },
    "DiagramSource": {
      "additionalProperties": false,
      "description": "A pointer into the codebase this node describes. Lets a diagram cite the code it models, so docs and agents can jump — or check staleness — at the recorded `commit`.",
      "properties": {
        "commit": {
          "description": "Commit SHA the reference was written against.",
          "type": "string"
        },
        "endLine": {
          "description": "1-based last line when the reference spans a range.",
          "type": "number"
        },
        "line": {
          "description": "1-based first line.",
          "type": "number"
        },
        "path": {
          "description": "Repo-relative path, e.g. `src/auth/session.ts`.",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "DiagramView": {
      "additionalProperties": false,
      "description": "A named stop in a guided tour. `views[]` turns a diagram into a document: an ordered set of camera/highlight states the reader can step through, and each `id` is stable enough to deep-link (`/player/<session>?view=<id>`).",
      "properties": {
        "caption": {
          "type": "string"
        },
        "connectors": {
          "items": {
            "$ref": "#/definitions/FocusConnectorRef"
          },
          "type": "array"
        },
        "id": {
          "description": "Stable slug — used by deep links and the views rail.",
          "type": "string"
        },
        "mode": {
          "description": "`append` adds direct neighbors of `node`; `replace` draws only the declared set. Views without `node` always behave as `replace`.",
          "enum": [
            "append",
            "replace"
          ],
          "type": "string"
        },
        "node": {
          "description": "Anchor node — behaves like selecting it, including its focusTarget story unless the view overrides the highlight set.",
          "type": "string"
        },
        "nodes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "steps": {
          "items": {
            "$ref": "#/definitions/FocusStep"
          },
          "type": "array"
        },
        "title": {
          "description": "Chapter title shown in the rail.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title"
      ],
      "type": "object"
    },
    "FileMeta": {
      "additionalProperties": false,
      "description": "Viewer/editor display state saved alongside the diagram in a file (the `_meta` key). Never affects geometry, structure validation, or diffs — the editor strips it into `diagramMeta` at load and writes it back at save.",
      "properties": {
        "colorMode": {
          "enum": [
            "light",
            "dark"
          ],
          "type": "string"
        },
        "isoStyle": {
          "type": "string"
        },
        "locale": {
          "description": "BCP-47 locale tag, e.g. `en`, `fr`, `ar` — viewer `lang`/`dir` + Intl formatting.",
          "type": "string"
        },
        "sourceUrl": {
          "type": "string"
        },
        "themeId": {
          "type": "string"
        },
        "viewMode": {
          "type": "string"
        },
        "viewport": {
          "additionalProperties": false,
          "properties": {
            "height": {
              "type": "number"
            },
            "width": {
              "type": "number"
            }
          },
          "required": [
            "width",
            "height"
          ],
          "type": "object"
        }
      },
      "type": "object"
    },
    "FlowDirection": {
      "description": "Direction a flow leg traverses its connector.",
      "enum": [
        "forward",
        "reverse"
      ],
      "type": "string"
    },
    "FlowEasing": {
      "description": "Per-interval animation easing for the moving marker.",
      "enum": [
        "linear",
        "ease-in",
        "ease-out",
        "ease-in-out"
      ],
      "type": "string"
    },
    "FlowMarker": {
      "description": "Marker shape riding a flow route. `packet` and `arrow` orient to travel.",
      "enum": [
        "dot",
        "packet",
        "pulse",
        "arrow"
      ],
      "type": "string"
    },
    "FlowTrail": {
      "description": "Motion trail treatment. `fade` shows trailing ghosts; `wake` also traces the route.",
      "enum": [
        "none",
        "fade",
        "wake"
      ],
      "type": "string"
    },
    "FocusConnectorRef": {
      "additionalProperties": false,
      "properties": {
        "from": {
          "description": "Endpoint-pair matching, used when `id` is absent. Ambiguous on parallel edges.",
          "type": "string"
        },
        "id": {
          "description": "Pins a specific connector by `Connector.id` — survives reordering and parallel edges.",
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "FocusStep": {
      "additionalProperties": false,
      "properties": {
        "icon": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "icon",
        "label"
      ],
      "type": "object"
    },
    "FocusTarget": {
      "additionalProperties": false,
      "description": "A declarative highlight story activated by hovering or selecting a node.",
      "properties": {
        "caption": {
          "type": "string"
        },
        "connectors": {
          "items": {
            "$ref": "#/definitions/FocusConnectorRef"
          },
          "type": "array"
        },
        "mode": {
          "description": "`append` includes direct neighbors; `replace` uses only the explicit story.",
          "enum": [
            "append",
            "replace"
          ],
          "type": "string"
        },
        "nodes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "steps": {
          "items": {
            "$ref": "#/definitions/FocusStep"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "GroupLayoutDirection": {
      "enum": [
        "horizontal",
        "vertical"
      ],
      "type": "string"
    },
    "GroupLayoutHint": {
      "additionalProperties": false,
      "description": "Layout policy for the nodes inside one group frame.",
      "properties": {
        "align": {
          "$ref": "#/definitions/LayoutAlignment"
        },
        "direction": {
          "$ref": "#/definitions/GroupLayoutDirection",
          "description": "`horizontal` lays layers left-to-right; `vertical` lays them top-to-bottom."
        },
        "itemGap": {
          "type": "number"
        },
        "justify": {
          "anyOf": [
            {
              "$ref": "#/definitions/LayoutAlignment"
            },
            {
              "const": "space-between",
              "type": "string"
            }
          ]
        },
        "layerGap": {
          "type": "number"
        },
        "padding": {
          "type": "number"
        }
      },
      "type": "object"
    },
    "GroupShape": {
      "additionalProperties": false,
      "properties": {
        "color": {
          "$ref": "#/definitions/DiagramColor"
        },
        "dashed": {
          "type": "boolean"
        },
        "height": {
          "type": "number"
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "type": {
          "enum": [
            "rect",
            "circle"
          ],
          "type": "string"
        },
        "width": {
          "type": "number"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "id",
        "x",
        "y",
        "width",
        "height",
        "type",
        "color"
      ],
      "type": "object"
    },
    "LabelAlign": {
      "enum": [
        "left",
        "right",
        "center"
      ],
      "type": "string"
    },
    "LayoutAlignment": {
      "enum": [
        "start",
        "center",
        "end"
      ],
      "type": "string"
    },
    "LayoutHints": {
      "additionalProperties": false,
      "properties": {
        "groups": {
          "additionalProperties": {
            "$ref": "#/definitions/GroupLayoutHint"
          },
          "type": "object"
        },
        "nodes": {
          "additionalProperties": {
            "$ref": "#/definitions/NodeLayoutHint"
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "LegendMode": {
      "description": "Legend policy for the edge/group key. `auto` lists the connector styles actually used plus labelled groups; `all` lists every connector style (used or not); `hidden` never shows the key.",
      "enum": [
        "auto",
        "all",
        "hidden"
      ],
      "type": "string"
    },
    "NodeData": {
      "additionalProperties": false,
      "properties": {
        "color": {
          "$ref": "#/definitions/DiagramColor",
          "description": "Palette color. Omit when `kind` supplies the default color."
        },
        "description": {
          "type": "string"
        },
        "icon": {
          "description": "Lucide icon name. Omit when `kind` supplies the default icon.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/NodeKind",
          "description": "Semantic role — supplies default `icon` and `color`; explicit fields still win."
        },
        "name": {
          "type": "string"
        },
        "shape": {
          "$ref": "#/definitions/NodeShape",
          "description": "Per-node silhouette. Omit to follow the theme's own node shape."
        },
        "source": {
          "$ref": "#/definitions/DiagramSource",
          "description": "Code this node describes — see `sourceUrl`/`sourceLabel` in utils/sourceRef."
        },
        "subtitle": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "NodeKind": {
      "description": "Semantic role for a node. When set, `icon` and `color` may be omitted — NODE_KIND_DEFAULTS supplies them — and every renderer resolves the kind through the theme palette the same way an authored `color` resolves.",
      "enum": [
        "frontend",
        "backend",
        "service",
        "database",
        "cache",
        "queue",
        "storage",
        "gateway",
        "security",
        "user",
        "external",
        "observability"
      ],
      "type": "string"
    },
    "NodeLayoutHint": {
      "additionalProperties": false,
      "description": "Optional placement hints used by autoLayout when nodes belong to groups.",
      "properties": {
        "group": {
          "description": "ID of the group frame that owns this node.",
          "type": "string"
        },
        "layer": {
          "description": "Explicit layer within the group. Connected nodes are layered automatically otherwise.",
          "type": "number"
        },
        "order": {
          "description": "Stable ordering within a layer. Lower values render first.",
          "type": "number"
        }
      },
      "type": "object"
    },
    "NodePosition": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "type": "number"
        },
        "isoDepth": {
          "description": "Isometric box depth (Y in iso space).",
          "type": "number"
        },
        "isoHeight": {
          "description": "Isometric box height.",
          "type": "number"
        },
        "isoLabelDir": {
          "description": "Top-face label axis. Omit / `auto` = along the longer edge.",
          "enum": [
            "auto",
            "x",
            "y"
          ],
          "type": "string"
        },
        "isoLabelFlip": {
          "description": "Rotate the printed iso label 180° on the face.",
          "type": "boolean"
        },
        "isoLabelFont": {
          "description": "Typeface for the printed iso label. Omit / `theme` follows the diagram brand.",
          "enum": [
            "theme",
            "ui",
            "mono"
          ],
          "type": "string"
        },
        "isoOrder": {
          "description": "Painter's-algorithm bias when two iso boxes occupy the same volume.",
          "type": "number"
        },
        "size": {
          "$ref": "#/definitions/NodeSize"
        },
        "width": {
          "description": "Custom rendered dimensions; when present they override the size preset.",
          "type": "number"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "description": "Isometric elevation above the floor plane.",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "size"
      ],
      "type": "object"
    },
    "NodeShape": {
      "enum": [
        "rounded",
        "square",
        "chamfer",
        "notch",
        "pill"
      ],
      "type": "string"
    },
    "NodeSize": {
      "enum": [
        "xs",
        "s",
        "m",
        "l"
      ],
      "type": "string"
    }
  }
}
