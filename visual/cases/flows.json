{
  "layout": { "width": 720, "height": 300 },
  "nodes": {
    "client": { "x": 40, "y": 110, "size": "m" },
    "gateway": { "x": 280, "y": 110, "size": "m" },
    "queue": { "x": 520, "y": 40, "size": "m" },
    "worker": { "x": 520, "y": 180, "size": "m" }
  },
  "nodeData": {
    "client": { "icon": "Monitor", "name": "Client", "color": "violet" },
    "gateway": { "icon": "Shield", "name": "Gateway", "color": "blue", "shape": "chamfer" },
    "queue": { "icon": "Package", "name": "Queue", "color": "emerald" },
    "worker": { "icon": "Zap", "name": "Worker", "color": "amber" }
  },
  "connectors": [
    { "id": "request", "from": "client", "to": "gateway", "fromAnchor": "right", "toAnchor": "left", "style": "request" },
    { "id": "enqueue", "from": "gateway", "to": "queue", "fromAnchor": "right", "toAnchor": "left", "style": "event" },
    { "id": "work", "from": "gateway", "to": "worker", "fromAnchor": "right", "toAnchor": "left", "style": "job", "curve": "step" }
  ],
  "connectorStyles": {
    "request": { "color": "blue", "strokeWidth": 2, "label": "HTTPS" },
    "event": { "color": "emerald", "strokeWidth": 2, "label": "event" },
    "job": { "color": "amber", "strokeWidth": 2, "label": "job", "dashed": true }
  },
  "flows": [
    {
      "id": "message",
      "label": "Message",
      "legs": [
        { "id": "request" },
        { "id": "enqueue", "pause": 0.35 },
        { "id": "work" }
      ],
      "duration": 3.2,
      "delay": 0.3,
      "hold": 0.7,
      "repeat": "indefinite",
      "easing": "ease-in-out",
      "marker": "packet",
      "color": "emerald",
      "size": 11,
      "trail": "wake"
    }
  ]
}
